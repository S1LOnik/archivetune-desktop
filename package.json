{
  "name": "archivetune-desktop",
  "version": "16.2.0-beta.1",
  "description": "ArchiveTune Desktop (V16 Beta) \u2014 Dual-Deck Smart DJ Automix, Universal Lossless Matrix, Word-by-Word Lyrics & Motion Canvas",
  "private": true,
  "author": {
    "name": "hari45wavin",
    "email": "harijoshi215@gmail.com"
  },
  "license": "MIT",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "vite --port 5173",
    "dev:main": "wait-on http://localhost:5173 && npm run build:audio-dsp && tsc -p tsconfig.main.json && electron dist/main/index.js",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "npm run build:audio-dsp && npm run build:native-spotify && tsc -p tsconfig.main.json",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-engine.mjs",
    "test:audio-dsp": "node --test scripts/test-audio-dsp.cjs",
    "test:source-routing": "node scripts/test-source-routing.cjs",
    "build:audio-dsp": "node scripts/build-audio-dsp.cjs",
    "build:native-spotify": "python3 scripts/build-spotify-native.py"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.0",
    "@types/ws": "^8.18.2",
    "framer-motion": "^11.12.0",
    "lucide-react": "^0.468.0",
    "mpris-service": "^2.1.2",
    "music-metadata": "^12.4.0",
    "node-shazam": "^1.2.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "ws": "^8.22.2",
    "youtubei.js": "^18.3.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.rukamori.archivetune.linux",
    "productName": "ArchiveTune",
    "linux": {
      "target": [
        "AppImage",
        "dir"
      ],
      "category": "Audio",
      "icon": "assets/icon.png",
      "synopsis": "YouTube Music & Local Files Player",
      "description": "ArchiveTune for Linux \u2014 the cutest music player with YouTube Music streaming, local library, synced lyrics, crossfade, and Last.fm scrobbling."
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**",
      "assets/**",
      "!assets/spotify-native/**"
    ],
    "extraResources": [
      {
        "from": "assets/spotify-native",
        "to": "spotify-native",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
